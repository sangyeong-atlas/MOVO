# Python reads exported environment variables; .env is not auto-loaded.
PORT=8787
# HOPON_DB=/absolute/private/path/hopon.db
LOCATION_STALE_SECONDS=10
LOCATION_LOST_SECONDS=30

# 카카오 로컬 API (장소 검색 · 목적지/경유지/픽업 모달 실제 데이터)
# https://developers.kakao.com → 앱 생성 → REST API 키 발급 → 카카오 로컬 서비스 활성화
# 미설정 시 PLACES 샘플 배열로 자동 대체 (서버 fallback)
KAKAO_REST_API_KEY=

